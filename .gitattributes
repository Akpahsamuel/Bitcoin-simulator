# GitHub Linguist — repo language statistics
#
# Linguist classifies any `examples/` path as *documentation* by default
# (rule: `(^|/)[Ee]xamples?/`), which drops every Python/TypeScript/Rust/Go
# lab from the language bar and leaves only the shell scripts + Dockerfile.
# Override that so the labs count as real code.
examples/**                    linguist-documentation=false
examples/**                    linguist-vendored=false

# ...but keep generated lockfiles out of the numbers.
examples/**/Cargo.lock         linguist-generated=true
examples/**/go.sum             linguist-generated=true
examples/**/package-lock.json  linguist-generated=true
